{
  "info": {
    "_postman_id": "51d60c9e-9192-49ee-bf62-2b4fb2bd3190",
    "name": "GLMS API",
    "description": "Manual and ordered API checks for local GLMS. Register and verify an account first; the verification code is printed by the Development API to its console.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5265", "type": "string" },
    { "key": "email", "value": "replace-with-your-test-email@example.com", "type": "string" },
    { "key": "password", "value": "ChangeThis!Password123", "type": "string" },
    { "key": "otpCode", "value": "000000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "clientId", "value": "", "type": "string" },
    { "key": "contractId", "value": "", "type": "string" },
    { "key": "serviceRequestId", "value": "", "type": "string" },
    { "key": "contractReference", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1 - API status",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API health endpoint returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected endpoint rejects anonymous request",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/clients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Protected endpoint returns 401 without a JWT', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Account",
      "item": [
        {
          "name": "Register account",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/account/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email with OTP",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/account/verify"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verification returns a JWT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('accessToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/account/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a JWT', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('accessToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification code",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/account/resend-verification"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend returns 202 or the one-minute rate limit', function () {",
                  "    pm.expect([202, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Clients",
      "item": [
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Clients endpoint returns an array', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Client\",\n  \"contactDetails\": \"postman@example.test\",\n  \"region\": \"Southern Africa\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/clients"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.exist;",
                  "    pm.environment.set('clientId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created client",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created client can be read back', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('clientId')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Contracts",
      "item": [
        {
          "name": "List contracts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/contracts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contracts endpoint returns an array', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter contracts with invalid date range",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/contracts?fromDate=2026-12-31&toDate=2026-01-01"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid date range returns 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create active contract (select a PDF)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const today = new Date();",
                  "const start = new Date(today);",
                  "start.setUTCDate(start.getUTCDate() - 1);",
                  "const end = new Date(today);",
                  "end.setUTCDate(end.getUTCDate() + 30);",
                  "                  pm.environment.set('contractStartDate', start.toISOString().slice(0, 10));",
                  "                  pm.environment.set('contractEndDate', end.toISOString().slice(0, 10));",
                  "                  pm.environment.set('contractReference', 'PM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contract is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.exist;",
                  "    pm.environment.set('contractId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "Reference", "value": "{{contractReference}}", "type": "text" },
                { "key": "ServiceLevel", "value": "Priority", "type": "text" },
                { "key": "StartDate", "value": "{{contractStartDate}}", "type": "text" },
                { "key": "EndDate", "value": "{{contractEndDate}}", "type": "text" },
                { "key": "Status", "value": "Active", "type": "text" },
                { "key": "ClientId", "value": "{{clientId}}", "type": "text" },
                { "key": "Agreement", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/contracts"
          }
        },
        {
          "name": "Download contract agreement",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/contracts/{{contractId}}/agreement"
          }
        },
        {
          "name": "Change contract status to OnHold",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OnHold\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/contracts/{{contractId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contract status is updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('OnHold');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - Service requests and dashboard",
      "item": [
        {
          "name": "Current USD to ZAR rate",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/service-requests/current-rate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rate endpoint returns a positive rate', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().rate).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create service request (requires active contract)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractId\": {{contractId}},\n  \"description\": \"Postman API test shipment\",\n  \"usdCost\": 125.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/service-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service request is created and converted to ZAR', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.exist;",
                  "    pm.expect(body.localCost).to.be.above(0);",
                  "    pm.environment.set('serviceRequestId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List service requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/service-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service requests endpoint returns an array', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard summary has expected counts and recent requests', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.clientCount).to.be.a('number');",
                  "    pm.expect(body.recentRequests).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
